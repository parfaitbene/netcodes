{
  "name": "netcodes",
  "version": "1.0.0",
  "description": "Cross-platform desktop app for storing and organizing code snippets",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev && electron .\"",
    "electron:build": "npm run build && npm run rebuild:electron && electron-builder",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 --module-dir .",
    "rebuild:node": "npm rebuild better-sqlite3"
  },
  "keywords": [
    "electron",
    "react",
    "code-snippets",
    "developer-tools"
  ],
  "author": "Parfait BENE",
  "website": "https://parfaitbene.com",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "better-sqlite3": "^12.10.0",
    "custom-electron-prompt": "^1.5.8",
    "docx": "^9.7.1",
    "dompurify": "^3.4.8",
    "marked": "^11.1.1",
    "pg": "^8.22.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^8.2.2",
    "electron": "^40.3.3",
    "electron-builder": "^26.15.0",
    "electron-rebuild": "^3.2.9",
    "vite": "^5.0.12",
    "vitest": "^4.1.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.netcodes.app",
    "productName": "NetCodes",
    "icon": "build/icon.png",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
